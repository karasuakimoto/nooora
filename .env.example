DISCORD_TOKEN=replace-me
DATABASE_URL=postgres://nooora:nooora@localhost:5432/nooora
# Optional. In-process locks still protect a single bot process when this is unset.
REDIS_URL=redis://127.0.0.1:6379
NOOORA_PORTAL_URL=https://nooora.example
# Instant slash registration while global commands propagate.
NOOORA_DEV_GUILD_ID=
NOOORA_REGISTER_GLOBAL=1
NOOORA_DROP_MAX=3
NOOORA_GRAB_MAX=1
NOOORA_DROP_REGEN_SECS=1800
NOOORA_GRAB_REGEN_SECS=900
NOOORA_SERIES_BOOST=3
NOOORA_EVENT_BOOST=2
NOOORA_TRADE_GATE=100
NOOORA_SERIES_COOLDOWN_SECS=518400
NOOORA_DROP_TTL_SECS=180
